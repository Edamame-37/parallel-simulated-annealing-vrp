*.dll
*.a

# --- File Log & Berkas Sementara Eksekusi ---
*.log
*.tmp
*.bak
*.swp
*~

# --- Konfigurasi Editor / IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Berkas Sistem Operasi ---
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
